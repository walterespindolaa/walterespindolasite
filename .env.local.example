# Copie este arquivo para .env.local e preencha o que for usar.
# TUDO É OPCIONAL pra rodar: sem as chaves, os widgets correspondentes só ficam vazios.

# GitHub (mapa de contribuições / stats) - crie um token em github.com/settings/tokens
NEXT_PUBLIC_GITHUB_USERNAME=seu_usuario_github
GITHUB_TOKEN=

# WakaTime (horas de código) - wakatime.com/settings/api-key
WAKATIME_API_KEY=

# Chatbot com IA (Groq principal, Gemini fallback)
GROQ_API_KEY=
GEMINI_API_KEY=

# Kaggle (opcional)
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=

# Formulário de contato por e-mail (nodemailer / Gmail app password)
EMAIL_USER=
EMAIL_APP_PASSWORD=
